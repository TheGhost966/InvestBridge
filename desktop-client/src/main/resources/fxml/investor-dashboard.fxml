<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.platform.desktop.view.controller.InvestorDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="InvestBridge" styleClass="top-bar-title"/>
            <Label text="·"            styleClass="top-bar-sep"/>
            <Label text="Investor"     styleClass="top-bar-role investor"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="identityLabel" styleClass="muted-label"/>
            <Button text="Logout" onAction="#onLogout" styleClass="ghost-button"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="dashboard-tabs">

            <!-- ── Browse verified ideas ─────────────────────────────────────── -->
            <Tab text="Browse ideas">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Verified ideas" styleClass="page-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#onRefreshBrowse" styleClass="ghost-button"/>
                        </HBox>
                        <Label fx:id="browseStatus" styleClass="muted-label" text=""/>
                        <ScrollPane fitToWidth="true" styleClass="card-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="browseList" spacing="12">
                                    <padding><Insets top="4" right="2" bottom="20" left="2"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </Tab>

            <!-- ── My investor profile ───────────────────────────────────────── -->
            <Tab text="My profile">
                <content>
                    <VBox spacing="14" maxWidth="520">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                        <Label text="Investor profile" styleClass="page-title"/>
                        <Label fx:id="profileStatus" styleClass="muted-label" text=""/>

                        <VBox spacing="6">
                            <Label text="Bio*" styleClass="field-label"/>
                            <TextArea fx:id="bioField" promptText="Short bio — sectors of interest, past investments, philosophy…"
                                      wrapText="true" prefRowCount="4"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Sectors of interest" styleClass="field-label"/>
                            <TextField fx:id="sectorsField" promptText="Comma-separated, e.g. ai, climate, healthtech"/>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Min € per ticket" styleClass="field-label"/>
                                <TextField fx:id="minField" promptText="e.g. 5000"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Max € per ticket" styleClass="field-label"/>
                                <TextField fx:id="maxField" promptText="e.g. 50000"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="profileError" styleClass="error-label" wrapText="true"
                               managed="false" visible="false"/>

                        <HBox spacing="10">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="saveProfileBtn" text="Create profile"
                                    onAction="#onSaveProfile" styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- ── My outgoing offers ────────────────────────────────────────── -->
            <Tab text="My offers">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Offers I have made" styleClass="page-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#onRefreshOffers" styleClass="ghost-button"/>
                        </HBox>
                        <Label fx:id="offersStatus" styleClass="muted-label" text=""/>
                        <ScrollPane fitToWidth="true" styleClass="card-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="offersList" spacing="10">
                                    <padding><Insets top="4" right="2" bottom="20" left="2"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </Tab>

            <!-- ── My matches (accepted offers) ──────────────────────────────── -->
            <Tab text="My matches">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Matched investments" styleClass="page-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Refresh" onAction="#onRefreshMatches" styleClass="ghost-button"/>
                        </HBox>
                        <Label fx:id="matchesStatus" styleClass="muted-label" text=""/>
                        <ScrollPane fitToWidth="true" styleClass="card-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="matchesList" spacing="10">
                                    <padding><Insets top="4" right="2" bottom="20" left="2"/></padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
